{
  "name": "renamer",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Utility local para aplanar carpetas y renombrar archivos por patron",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "dev": "node --watch --experimental-strip-types src/server.ts",
    "test": "node --test --experimental-strip-types test/*.test.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@fastify/static": "^10.1.5",
    "better-sqlite3": "^11.5.0",
    "fastify": "^5.1.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.11",
    "@types/node": "^22.9.0",
    "typescript": "^5.7.2"
  }
}
